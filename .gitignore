# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-finetune

# Root-level data/artifact dirs -- anchored with a leading slash so these don't
# also match same-named subdirectories (config/models/, config/datasets/ were
# being silently swallowed by the old bare "models/"/"datasets/" rules and had
# never been tracked as a result).
/models/
/datasets/
/failures/
/logs/
/outputs/
/checkpoints/
annotation-tool/annotations/

# User-specific cluster config
cluster/env.sh

# Linux binaries / wheels / model cache shipped to cluster (built by run.sh)
cluster/bin/
cluster/wheels*/
cluster/hf_cache/
annotation-tool/introductions
annotation-tool/.venv

# macOS
.DS_Store
**/.DS_Store

# Secrets
.env
