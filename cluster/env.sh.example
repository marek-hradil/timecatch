#!/bin/bash
# Copy to cluster/env.sh and fill in your values. cluster/env.sh is gitignored.
# Find your project/account with:  bsc_project list  (run on any login node)

export CLUSTER_USER="bsc999999"                       # your BSC username
export CLUSTER_TRANSFER_HOST="transfer1.bsc.es"       # for rsync of code/data from laptop
export CLUSTER_INTERNET_HOST="alogin1.bsc.es"         # ssh target for prepare.sh (any login node works)
export CLUSTER_LOGIN_HOST="alogin1.bsc.es"            # regular login

export PROJECT="bsc99"                                # from bsc_project list
export ACCOUNT="$PROJECT"                             # usually same as PROJECT
export REMOTE_DIR="/gpfs/projects/$PROJECT/$CLUSTER_USER/temporal-misalignment"
export HF_CACHE="/gpfs/projects/$PROJECT/$CLUSTER_USER/hf_cache"

export CLUSTER_PYTHON_VERSION="3.12"                  # `python --version` after `module load python`
